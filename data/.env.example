# Copier ce fichier en `.env` (jamais commité) et renseigner les valeurs.
# Si `data/.env` n'existe pas, le CLI lit `back/.env` en secours : les deux
# variables Supabase y sont identiques, inutile de les dupliquer.

# URL du projet : Supabase > Project Settings > API > Project URL.
SUPABASE_URL=https://lfvhofjksqtcyardlfja.supabase.co

# Clé service_role : Supabase > Project Settings > API > service_role (secret).
# Elle contourne la Row Level Security : uniquement côté serveur, jamais dans le front.
SUPABASE_SERVICE_ROLE_KEY=remplacer-par-la-cle-service-role

# --- Commande `france-travail` uniquement ---
# Identifiants OAuth2 de l'application créée sur https://francetravail.io
# (abonnée à l'API « Offres d'emploi v2 »). Sans eux, la commande s'arrête avec la marche à suivre.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
