{
  "name": "interimatch-data",
  "version": "0.1.0",
  "private": true,
  "description": "CLI d'import et de nettoyage des données publiques CleanMatch (communes, France Travail) vers Supabase",
  "main": "dist/cli.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "commander": "^14.0.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
