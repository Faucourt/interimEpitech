{
  "info": {
    "name": "CleanMatch — API",
    "description": "Scénario de démonstration complet de l'API CleanMatch, dans l'ordre.\n\n**Avant de lancer** : démarrer le back (`cd back && npm run dev`) et renseigner la variable `adminPassword` dans l'onglet Variables de la collection.\n\nLes jetons et identifiants se propagent automatiquement d'une requête à l'autre : il suffit de dérouler les dossiers dans l'ordre, ou de lancer le Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminEmail",
      "value": "admin@cleanmatch.fr"
    },
    {
      "key": "adminPassword",
      "value": "",
      "description": "À renseigner — demander à l'équipe"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "entrepriseEmail",
      "value": ""
    },
    {
      "key": "entrepriseTempPassword",
      "value": ""
    },
    {
      "key": "entreprisePassword",
      "value": "MotDePasseEntreprise2026"
    },
    {
      "key": "entrepriseToken",
      "value": ""
    },
    {
      "key": "agentEmail",
      "value": ""
    },
    {
      "key": "agentPassword",
      "value": "MotDePasseAgent2026"
    },
    {
      "key": "agentToken",
      "value": ""
    },
    {
      "key": "missionId",
      "value": ""
    },
    {
      "key": "candidatureId",
      "value": ""
    },
    {
      "key": "competenceId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 — Santé",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Vérifie que le back répond avant de dérouler le scénario."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API en ligne', () => pm.response.to.have.status(200));",
                  "pm.test('statut ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 — Admin : créer une entreprise",
      "item": [
        {
          "name": "Connexion admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Le compte admin est créé par seed en base, il ne s'inscrit pas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('connecté', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', d.token);",
                  "pm.test('rôle ADMIN', () => pm.expect(d.user.role).to.eql('ADMIN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Créer un compte entreprise",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/entreprises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "entreprises"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"contact+{{$timestamp}}@propretech.fr\",\n  \"raisonSociale\": \"PropreTech Services\",\n  \"siret\": \"81234567800019\",\n  \"telephone\": \"0148120034\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Une entreprise ne s'inscrit jamais elle-même : l'admin crée le compte et transmet un mot de passe temporaire, à changer à la première connexion."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('créée', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('entrepriseEmail', d.user.email);",
                  "pm.collectionVariables.set('entrepriseTempPassword', d.temporaryPassword);",
                  "pm.test('mot de passe temporaire renvoyé une seule fois',",
                  "  () => pm.expect(d.temporaryPassword).to.be.a('string').and.not.empty);",
                  "pm.test('doit changer son mot de passe',",
                  "  () => pm.expect(d.user.mustChangePassword).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
