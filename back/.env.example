# Copier ce fichier en `.env` (jamais commité) et renseigner les valeurs.
# Un seul fichier pour tout le dossier back/ : l'API (src/config.ts) et le CLI d'import des
# données publiques (src/cli/config.ts) le lisent tous les deux.

# development | test | production
NODE_ENV=development

# Port d'écoute HTTP de l'API.
PORT=3000

# Origine autorisée par le CORS. En local : le front Vite.
CORS_ORIGIN=http://localhost:5173

# Secret HMAC de signature des JWT — 32 caractères minimum, unique par environnement.
# Obligatoire hors test : l'API refuse de démarrer sans.
# Générer une valeur : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=remplacer-par-une-valeur-aleatoire-de-48-caracteres-minimum

# Durée de vie d'un token (format jsonwebtoken : 2h, 24h, 7d…). Pas de refresh token dans ce POC.
JWT_EXPIRES_IN=24h

# PostgreSQL (base relationnelle). En local : `docker compose up -d` à la racine du dépôt,
# puis `npm run db:migrate` pour créer les tables. Obligatoire hors test.
DATABASE_URL=postgres://cleanmatch:cleanmatch@localhost:5432/cleanmatch

# Compte ADMIN créé par `npm run db:seed`. Mot de passe vide = généré et affiché une seule fois.
ADMIN_EMAIL=admin@cleanmatch.fr
ADMIN_PASSWORD=

# --- n8n (optionnel, contrat : README.md, section « Automatisations n8n ») ---
# Webhook appelé à la publication d'une mission. Vide = notification désactivée.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/cleanmatch/mission-publiee
# Secret partagé avec n8n (header X-Api-Key). Vide = route interne fermée (503).
N8N_API_KEY=

# --- MongoDB (optionnel, logs de matching) ---
# Vide = journalisation désactivée, le reste de l'API fonctionne.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=cleanmatch

# --- CLI `npm run import:france-travail` uniquement ---
# Identifiants OAuth2 de l'application créée sur https://francetravail.io
# (abonnée à l'API « Offres d'emploi v2 »). Sans eux, la commande s'arrête avec la marche à suivre.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
