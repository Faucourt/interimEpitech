# Copier ce fichier en `.env` (jamais commité) et renseigner les valeurs.
# Les variables sont lues dans src/config.ts.

# development | test | production
NODE_ENV=development

# Port d'écoute HTTP de l'API.
PORT=3000

# Origine autorisée par le CORS. En local : le front Vite.
CORS_ORIGIN=http://localhost:5173

# Secret HMAC de signature des JWT — 32 caractères minimum, unique par environnement.
# Obligatoire hors test : l'API refuse de démarrer sans.
# Générer une valeur : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=remplacer-par-une-valeur-aleatoire-de-48-caracteres-minimum

# Durée de vie d'un token (format jsonwebtoken : 2h, 24h, 7d…). Pas de refresh token dans ce POC.
JWT_EXPIRES_IN=24h

# URL du projet : Supabase > Project Settings > API > Project URL.
SUPABASE_URL=https://lfvhofjksqtcyardlfja.supabase.co

# Clé service_role : Supabase > Project Settings > API > service_role (secret).
# Elle contourne la Row Level Security : uniquement côté serveur, jamais dans le front.
SUPABASE_SERVICE_ROLE_KEY=remplacer-par-la-cle-service-role

# --- Intégration n8n (voir n8n/README.md). Les deux variables sont optionnelles. ---

# URL du webhook du workflow 1 (notification de matching), appelée à chaque publication de mission.
# Vide : aucun appel sortant, l'API fonctionne normalement (cas des postes sans n8n en local).
# En local avec n8n : http://localhost:5678/webhook/cleanmatch/mission-publiee
N8N_WEBHOOK_URL=

# Secret partagé avec n8n (credential « CleanMatch API Key », header X-Api-Key), dans les deux sens :
# envoyé au webhook ci-dessus, exigé sur GET /api/internal/missions/non-pourvues (workflow 2).
# Vide : la route interne répond 503 au lieu de s'ouvrir sans protection. Générer : openssl rand -hex 32
N8N_API_KEY=

# --- Base non relationnelle : MongoDB (logs de matching, rétention 6 mois par index TTL). Les deux sont optionnelles. ---

# URI de connexion. Vide : aucune journalisation, l'API fonctionne normalement (même principe que n8n).
# En local : mongodb://127.0.0.1:27017
MONGODB_URI=

# Nom de la base (cleanmatch par défaut).
MONGODB_DB=cleanmatch
